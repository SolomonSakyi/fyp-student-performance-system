<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="config" />
          <add segment="app" />
          <add segment="database" />
          <add segment="storage" />
          <add segment="vendor" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>