# ============================================
# Git Ignore File - EduTrack
# ============================================

# Database backups
/database/backups/*.sql
/database/backups/*.sql.gz

# Environment files (keep these SECRET!)
.env
.env.local
.env.*.local

# Composer dependencies
/vendor/
composer.phar
composer.lock

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Operating System files
Thumbs.db
.DS_Store

# Logs
*.log
/logs/
/log/

# Cache files
/cache/
/tmp/
/temp/

# Uploads (user uploaded files)
/uploads/
/storage/
/media/

# Node modules (if using any)
/node_modules/
package-lock.json
yarn.lock

# Build artifacts
/build/
/dist/
*.min.js
*.min.css

# Test coverage
/coverage/
.phpunit.result.cache
*.test

# Backup files
*.bak
*.backup
*.old
*.orig

# IDE settings
.settings/
.project
.classpath
*.iml
/.metadata/
.idea/workspace.xml
.idea/tasks.xml
.idea/dictionaries
.idea/vcs.xml
.idea/jsLibraryMappings.xml

# PHP specific
.php_cs.cache
.phpunit.result.cache
.phan/
.phpbench/